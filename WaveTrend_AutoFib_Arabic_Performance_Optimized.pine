plot(htf1_show ? htf1 : na, 'متوسط الإطار الأعلى 1', color = htf1_color, linewidth = math.max(1, htf1_width), style = htf1_style, show_last = htf1_size, force_overlay = true)

var label htf1lbl = na
if barstate.islast
    label.delete(htf1lbl)
    htf1lbl := htf1_label ? htfLabel(htf1, htf1_timeframe, htf1_color) : na
