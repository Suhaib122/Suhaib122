string extendStyle = input.string('تمديد يميناً', '', group = group0, inline = group0, options = ['تمديد يميناً', 'تمديد في الاتجاهين', 'بدون تمديد', 'تمديد يساراً'])
int fillTransparency = input.int(93, 'شفافية التعبئة:', group = group0, inline = 'mid', minval = 0, maxval = 100, step = 1)
