string tablePositionInput = input.string('أسفل اليمين', 'موضع الجدول', options = ['أسفل اليمين', 'أسفل اليسار', 'منتصف اليمين', 'منتصف اليسار', 'أعلى اليمين', 'أعلى اليسار', 'أعلى الوسط', 'أسفل الوسط'], group = group2, inline = 'fourthLine')
